{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "luckin",
  "version": "0.2.0",
  "description": "使用瑞幸官方 MCP 的本地社区咖啡插件，与瑞幸咖啡无关联。",
  "author": {
    "name": "Drswith"
  },
  "repository": "https://github.com/Drswith/luckin",
  "license": "MIT",
  "keywords": [
    "coffee",
    "luckin",
    "mcp-apps"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "Luckin",
        "shortDescription": "查询瑞幸门店、商品与订单",
        "longDescription": "本地社区插件：搜索瑞幸门店与商品，在界面核对并确认订单，跟进取餐状态。Token 仅在密码框输入或通过本机环境变量配置；提供仅本机记录的门店、搜索和插件订单。本项目与瑞幸咖啡无关联。",
        "developerName": "Drswith",
        "category": "Lifestyle",
        "brandColor": "#0022AB",
        "capabilities": [
          "查询门店和商品",
          "预览订单",
          "兼容界面中的订单确认与取消"
        ],
        "logo": "./assets/luckin-icon.png",
        "composerIcon": "./assets/luckin-icon.png",
        "defaultPrompt": [
          "帮我找附近的瑞幸门店，看看有哪些冰美式。",
          "帮我预览一杯冰美式的订单。"
        ]
      }
    }
  }
}
